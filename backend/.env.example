# Salin menjadi backend/.env (tidak di-commit). Isi hanya di laptop atau Secret Manager.
GEMINI_API_KEY=
NOTA_KLIEN=gemini            # "tiruan" = tanpa API key, data contoh
NOTA_MODEL=gemini-3.1-flash-lite
NOTA_TIMEOUT_DETIK=30
# NOTA_THINKING_LEVEL=LOW    # MINIMAL | LOW | MEDIUM | HIGH; diputuskan dari evaluasi
# NOTA_MEDIA_RESOLUTION=MEDIA_RESOLUTION_MEDIUM
NOTA_PAKAI_SKEMA=true
NOTA_MAKS_UKURAN_MB=4
APP_CHECK=off                # "enforce" di Cloud Run
APP_CHECK_CONSUME=true
NOTA_DOCS=false
